# -------------------------------------------------------------------------------------
# TMA Cloud | Environment Variables Configuration
# Documentation: https://tma-cloud.github.io/Wiki/docs/reference/environment-variables
# -------------------------------------------------------------------------------------

# --------------------------------------
# Application Configuration
# --------------------------------------
NODE_ENV=production
BPORT=3000
BACKEND_URL=http://localhost:3000

# --------------------------------------
# Database Configuration
# --------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tma_cloud_db_password
DB_NAME=tma_cloud_storage
DB_SSLMODE=disable
PGBOSS_SCHEMA=pgboss

# --------------------------------------
# JSON Web Token (JWT) & Session Security
# --------------------------------------
JWT_SECRET=tma_cloud_secret
FORCE_INSECURE_COOKIES=false

# --------------------------------------
# Google OAuth 2.0 Configuration
# --------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --------------------------------------
# File Uploads & Storage
# --------------------------------------
# The storage bucket is set by the first user in Settings > Storage.
# FILE_ENCRYPTION_KEY: master key for all files; back it up. Production needs a
# random 32-byte key ("npm run key:generate"). Leave empty under Docker, which
# uses secrets/file_encryption_key. Rotate with ./rotate.sh key or
# "npm run rotate -- key".
FILE_ENCRYPTION_KEY=
# FILE_ENCRYPTION_KEY_FILE=/run/secrets/file_encryption_key

# --------------------------------------
# Logging & Audit System
# --------------------------------------
LOG_LEVEL=info
METRICS_ALLOWED_IPS=127.0.0.1
AUDIT_WORKER_CONCURRENCY=5
AUDIT_JOB_TTL_SECONDS=82800

# --------------------------------------
# Redis Configuration
# --------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=tma_cloud_redis_password
REDIS_DB=0
