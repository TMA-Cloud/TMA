# -------------------------------------------------------------------------------------
# TMA Cloud | Environment Variables Configuration
# Documentation: https://tma-cloud.github.io/Wiki/docs/reference/environment-variables
# -------------------------------------------------------------------------------------

# --------------------------------------
# Application Configuration
# --------------------------------------
NODE_ENV=production
BPORT=3000
BACKEND_URL=http://localhost:3000

# --------------------------------------
# Database Configuration
# --------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tma_cloud_db_password
DB_NAME=tma_cloud_storage
DB_SSLMODE=disable
PGBOSS_SCHEMA=pgboss

# --------------------------------------
# JSON Web Token (JWT) & Session Security
# --------------------------------------
JWT_SECRET=tma_cloud_secret
FORCE_INSECURE_COOKIES=false
# Days of inactivity before a session ends. The token is re-issued while the
# user is active, so an active user is never logged out mid-use.
SESSION_IDLE_DAYS=30
# Reverse proxy hops to trust for the real client IP. Required for correct
# per-client rate limiting behind nginx/traefik. Use 0 when there is no proxy.
TRUST_PROXY=1

# --------------------------------------
# Google OAuth 2.0 Configuration
# --------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --------------------------------------
# File Uploads & Storage
# --------------------------------------
# Local disk (default) or S3-compatible: Cloudflare R2, RustFS, or AWS S3
STORAGE_DRIVER=local
UPLOAD_DIR=/app/uploads
FILE_ENCRYPTION_KEY=tma_cloud_file_encryption_key

# Master key version. To rotate: set a new FILE_ENCRYPTION_KEY, bump this, and
# keep the previous key as FILE_ENCRYPTION_KEY_V<oldVersion> until rotate-kek.js
# reports Remaining=0. See the wiki for the full rotation steps.
FILE_KEK_VERSION=1
# FILE_ENCRYPTION_KEY_V1=previous_master_key

# Cloudflare R2 (when STORAGE_DRIVER=s3)
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_BUCKET=your-bucket-name
# R2_ACCESS_KEY_ID=your-r2-api-token-access-key
# R2_SECRET_ACCESS_KEY=your-r2-api-token-secret
# R2_PUBLIC_URL=https://your-custom-domain.com

# Alternative: S3-compatible (RustFS/MinIO/AWS)
# RUSTFS_ENDPOINT=https://your-s3-endpoint
# RUSTFS_BUCKET=your-bucket-name
# RUSTFS_ACCESS_KEY=your-access-key
# RUSTFS_SECRET_KEY=your-secret-key
# RUSTFS_REGION=us-east-1

# --------------------------------------
# Logging & Audit System
# --------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
METRICS_ALLOWED_IPS=127.0.0.1
AUDIT_WORKER_CONCURRENCY=5
AUDIT_JOB_TTL_SECONDS=82800

# --------------------------------------
# Last-access ("Last opened") tracking
# --------------------------------------
# Set to 0/false to stop recording access times, the way Windows ships with
# NtfsDisableLastAccessUpdate set.
ACCESS_TIME_TRACKING=1
# How stale a stored timestamp must be before a read is written down again.
# 60 matches the one-hour accuracy NTFS promises; lower it for finer
# timestamps at the cost of more writes, 0 to record every single read.
ACCESS_TIME_WINDOW_MINUTES=60
# How long access times may sit buffered in memory before being written.
ACCESS_TIME_FLUSH_SECONDS=10

# --------------------------------------
# Redis Configuration
# --------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=tma_cloud_redis_password
REDIS_DB=0
