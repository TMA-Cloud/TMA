{
  "name": "tma-cloud-backend",
  "private": true,
  "version": "3.1.6",
  "description": "Backend for TMA Cloud",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "worker": "node audit-worker.js",
    "dev": "node --watch server.js",
    "dev:worker": "node --watch audit-worker.js",
    "s3:lifecycle": "node scripts/s3-lifecycle-incomplete-multipart.js",
    "s3:protect-all": "node scripts/s3-bucket-protect-all.js",
    "s3:public-block": "node scripts/s3-bucket-public-access-block.js",
    "s3:policy-https": "node scripts/s3-bucket-policy-https.js",
    "s3:versioning": "node scripts/s3-bucket-versioning.js",
    "s3:encryption": "node scripts/s3-bucket-encryption.js",
    "rotate": "node scripts/rotate.js",
    "key:generate": "node scripts/generate-key.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test:integration:coverage": "vitest run --config vitest.integration.config.js --coverage",
    "test:s3": "vitest run --config vitest.s3.config.js",
    "test:all": "npm run test && npm run test:integration",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "knip": "knip",
    "knip:production": "knip --production",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "tma-cloud",
    "storage",
    "backend"
  ],
  "author": "TMA Cloud",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22 || ^24 || >=26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22 || ^24 || >=26",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/lib-storage": "^3.1146.0",
    "@node-rs/bcrypt": "^1.10.9",
    "@prometheus-io/client": "^0.16.1",
    "archiver": "^8.0.0",
    "async-mutex": "^0.5.0",
    "busboy": "^1.6.0",
    "dotenv": "^18.0.5",
    "escape-html": "^1.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "file-type": "^22.1.1",
    "google-auth-library": "^11.1.0",
    "jsonwebtoken": "^9.0.3",
    "mime-db": "^1.54.0",
    "mime-types": "^3.0.2",
    "nanoid": "^6.0.1",
    "otplib": "^13.5.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.36.0",
    "pg-cursor": "^2.22.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "redis": "^6.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.3",
    "bcryptjs": "^3.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "knip": "^6.39.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  }
}
