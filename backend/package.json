{
  "name": "tma-cloud-backend",
  "private": true,
  "version": "3.0.0",
  "description": "Backend for TMA Cloud",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "worker": "node audit-worker.js",
    "dev": "nodemon server.js",
    "dev:worker": "nodemon audit-worker.js",
    "s3:lifecycle": "node scripts/s3-lifecycle-incomplete-multipart.js",
    "s3:protect-all": "node scripts/s3-bucket-protect-all.js",
    "s3:public-block": "node scripts/s3-bucket-public-access-block.js",
    "s3:policy-https": "node scripts/s3-bucket-policy-https.js",
    "s3:versioning": "node scripts/s3-bucket-versioning.js",
    "s3:encryption": "node scripts/s3-bucket-encryption.js",
    "migrate:streaming": "node scripts/migrate-to-streaming-encryption.js",
    "rotate:kek": "node scripts/rotate-kek.js",
    "backfill:envelope": "node scripts/backfill-envelope-encryption.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test:integration:coverage": "vitest run --config vitest.integration.config.js --coverage",
    "test:s3": "vitest run --config vitest.s3.config.js",
    "test:all": "npm run test && npm run test:integration",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "tma-cloud",
    "storage",
    "backend"
  ],
  "author": "ZIDAN44",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22 || ^24 || >=26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22 || ^24 || >=26",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1126.0",
    "@aws-sdk/lib-storage": "^3.1126.0",
    "archiver": "^8.0.0",
    "async-mutex": "^0.5.0",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "check-disk-space": "^3.4.0",
    "dotenv": "^17.4.2",
    "escape-html": "^1.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "file-type": "^22.0.2",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.3",
    "mime-db": "^1.54.0",
    "mime-types": "^3.0.2",
    "multer": "^2.3.0",
    "nanoid": "^6.0.1",
    "otplib": "^13.5.0",
    "pg": "^8.23.0",
    "pg-boss": "^12.30.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "vitest": "^5.0.0"
  }
}
