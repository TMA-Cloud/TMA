{
  "name": "tma-cloud-frontend",
  "private": true,
  "version": "3.0.0",
  "description": "Frontend for TMA Cloud",
  "keywords": [
    "tma-cloud",
    "storage",
    "frontend"
  ],
  "author": "ZIDAN44",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22 || ^24 || >=26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22 || ^24 || >=26",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview"
  },
  "dependencies": {
    "bytes": "^3.1.2",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.31.0",
    "mime": "^4.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-file-icon": "^1.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/bytes": "^3.1.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.22",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
