{
  "name": "tma-cloud-frontend",
  "private": true,
  "version": "3.1.5",
  "description": "Frontend for TMA Cloud",
  "keywords": [
    "tma-cloud",
    "storage",
    "frontend"
  ],
  "author": "TMA Cloud",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22 || ^24 || >=26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22 || ^24 || >=26",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "knip": "knip && knip --production",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.48.0",
    "@tanstack/react-virtual": "^3.14.13",
    "bytes": "^3.1.2",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.52.0",
    "mime": "^4.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bytes": "^3.1.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "knip": "^6.39.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
