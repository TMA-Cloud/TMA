# Allowlist: the image is built from frontend/ and backend/ only, so nothing
# else (secrets, electron, desktop-fs, backups) reaches the build context.
*
!frontend/
!backend/

# Secrets
**/.env
**/.env.*

# Installed or rebuilt inside the image
**/node_modules/
frontend/dist/
**/*.tsbuildinfo

# Tests, tooling and local output that the image doesn't use
**/tests/
**/coverage/
**/coverage-integration/
**/*.log
**/.prettierrc
**/.prettierignore
**/eslint.config.*
**/vitest*.config.*
frontend/eslint-rules/
backend/uploads/
