#!/bin/sh
# Runs the CI checks (minus integration tests, which need Postgres and Redis)
# when the pushed commits touch Rust code. It runs against the working tree,
# so uncommitted changes are included in the run.
set -eu

cd "$(git rev-parse --show-toplevel)"
. .githooks/lib.sh

changed=''
check_all=0

# One line per pushed ref: <local ref> <local sha> <remote ref> <remote sha>
while read -r _local_ref local_sha _remote_ref remote_sha; do
  case $local_sha in *[!0]*) ;; *) continue ;; esac # branch deletion
  case $remote_sha in
    *[!0]*)
      if git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        base=$remote_sha
      else
        base='' # remote has commits we don't: likely a force push
      fi
      ;;
    *) base='' ;; # new branch
  esac
  if [ -z "$base" ]; then
    default=$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || echo origin/main)
    base=$(git merge-base "$local_sha" "$default" 2>/dev/null || true)
  fi
  if [ -z "$base" ]; then
    check_all=1
  else
    changed="$changed
$(git diff --name-only "$base" "$local_sha")"
  fi
done

status=0
run() {
  _pkg=$1
  shift
  step "$_pkg: $*"
  if ! (cd "$_pkg" && "$@" </dev/null); then
    fail "$_pkg: $* failed"
    status=1
  fi
}

rust_changed() {
  [ "$check_all" -eq 1 ] || printf '%s\n' "$changed" | grep -qE '^(crates|apps|xtask)/|^Cargo\.(toml|lock)$|^rustfmt\.toml$'
}

if rust_changed; then
  if command -v cargo >/dev/null 2>&1; then
    run . cargo xtask ci
  else
    warn "cargo not found, skipping the Rust checks"
  fi
fi

# The wiki documents routes, codes, events, schema, settings and labels; check it still
# matches when they may have changed. Needs the wiki checkout: $TMA_WIKI, or the folder
# next to this repo that holds scripts/check-against-code.mjs.
wiki=${TMA_WIKI:-}
if [ -z "$wiki" ]; then
  for dir in ../*/; do
    if [ -f "${dir}scripts/check-against-code.mjs" ]; then
      wiki=${dir%/}
      break
    fi
  done
fi
docs_changed() {
  [ "$check_all" -eq 1 ] || printf '%s\n' "$changed" | grep -qE '^(crates/tma-server|crates/tma-ui|apps)/|^\.env\.example$|^Cargo\.toml$'
}
if docs_changed; then
  if [ -f "$wiki/scripts/check-against-code.mjs" ] && command -v node >/dev/null 2>&1; then
    step "wiki: check-against-code"
    if ! node "$wiki/scripts/check-against-code.mjs" "$(pwd)" </dev/null; then
      fail "the wiki no longer matches the code: update $wiki (see WRITING.md there)"
      status=1
    fi
  else
    warn "wiki checkout or node not found, skipping the docs comparison"
  fi
fi

[ "$status" -eq 0 ] || fail "pre-push failed (bypass with --no-verify only if you must)"
exit "$status"
