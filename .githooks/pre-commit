#!/bin/sh
# Checks only what is being committed, so it stays fast. Files whose working
# copy differs from the index are checked from the index through stdin, so a
# half-staged file is judged on what will actually land.
set -eu

cd "$(git rev-parse --show-toplevel)"
. .githooks/lib.sh

staged=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0
unstaged=$(git -c core.quotePath=false diff --name-only)
status=0
max_bytes=$((5 * 1024 * 1024))

env_files=$(printf '%s\n' "$staged" | grep -E '(^|/)\.env(\.[^/]*)?$' | grep -vE '\.env\.(example|test)$' || true)
if [ -n "$env_files" ]; then
  fail "refusing to commit environment files (secrets):"
  printf '%s\n' "$env_files" | sed 's/^/    /' >&2
  status=1
fi

markers=$(printf '%s\n' "$staged" | nul | xargs -0 git grep --cached -nE '^(<{7}|>{7})( |$)' -- 2>/dev/null || true)
if [ -n "$markers" ]; then
  fail "merge conflict markers:"
  printf '%s\n' "$markers" | sed 's/^/    /' >&2
  status=1
fi

printf '%s\n' "$staged" | while IFS= read -r f; do
  size=$(git cat-file -s ":$f" 2>/dev/null || echo 0)
  if [ "$size" -gt "$max_bytes" ]; then
    fail "$f is $((size / 1024 / 1024)) MB (limit 5 MB); keep large files out of git"
    exit 1
  fi
done || status=1

# Vendored crates stay as upstream wrote them, like cargo fmt (which skips them) and Prettier below.
rs_files=$(printf '%s\n' "$staged" | grep -E '\.rs$' | grep -vE '^(vendor|target)/' || true)
if [ -n "$rs_files" ]; then
  if command -v rustfmt >/dev/null 2>&1; then
    step "rustfmt on $(printf '%s\n' "$rs_files" | wc -l | tr -d ' ') file(s)"
    partial=$(filter_by "$rs_files" "$unstaged" keep)
    clean=$(filter_by "$rs_files" "$partial" drop)
    if [ -n "$clean" ] && ! printf '%s\n' "$clean" | nul | xargs -0 rustfmt --edition 2024 --check >/dev/null; then
      fail "formatting; fix with: cargo fmt"
      status=1
    fi
    tmp=$(mktemp)
    printf '%s\n' "$partial" | sed '/^$/d' | while IFS= read -r f; do
      git show ":$f" >"$tmp"
      # Both sides of the pipe only read $tmp.
      # shellcheck disable=SC2094
      if ! rustfmt --edition 2024 --config-path rustfmt.toml --emit stdout <"$tmp" 2>/dev/null | cmp -s - "$tmp"; then
        fail "$f: staged content isn't formatted"
        exit 1
      fi
    done || status=1
    rm -f "$tmp"
  else
    warn "rustfmt not found, skipping the format check"
  fi
fi

# Prettier formats what rustfmt does not; the version matches xtask's.
pretty_files=$(printf '%s\n' "$staged" | grep -E '\.(md|ya?ml|json|html|css)$' | grep -vE '^(vendor|target)/' || true)
if [ -n "$pretty_files" ]; then
  if command -v npx >/dev/null 2>&1; then
    step "prettier on $(printf '%s\n' "$pretty_files" | wc -l | tr -d ' ') file(s)"
    whole=$(filter_by "$pretty_files" "$unstaged" drop)
    if [ -n "$whole" ] && ! printf '%s\n' "$whole" | nul | xargs -0 npx --yes prettier@3.9.9 --check --log-level warn; then
      fail "formatting; fix with: cargo xtask fmt"
      status=1
    fi
  else
    warn "npx not found, skipping the Prettier check"
  fi
fi

[ "$status" -eq 0 ] || fail "pre-commit failed (bypass with --no-verify only if you must)"
exit "$status"
