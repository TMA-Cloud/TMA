{
  "appId": "com.tmacloud.app",
  "productName": "TMA Cloud",
  "copyright": "Copyright © ${author}",
  "directories": { "output": "dist-client" },
  "extraMetadata": { "main": "dist-electron/main/index.cjs" },
  "files": ["dist-electron/**/*"],
  "extraResources": [{ "from": "clouddrive-dist", "to": "clouddrive" }],
  "win": {
    "target": ["nsis"],
    "signAndEditExecutable": true,
    "icon": "src/build/icon.png"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": true,
    "runAfterFinish": true,
    "installerHeaderIcon": "src/build/installerHeaderIcon.ico",
    "include": "src/build/installer.nsh",
    "uninstallUrlHelp": "https://tma-cloud.github.io/Wiki/docs/getting-started/desktop-app",
    "uninstallUrlUpdateInfo": "https://github.com/TMA-Cloud/TMA/releases"
  }
}
