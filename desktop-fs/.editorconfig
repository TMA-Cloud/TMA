root = true

# TMA Cloud Drive host (C# / .NET 9). Drives `dotnet format` — both the
# whitespace formatter and the analyzer/style linter read these rules.

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets}]
indent_size = 2

[*.{json,cjs,js,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# --- code style ---
# Whitespace/formatting below is enforced by `dotnet format` (and reported by
# `--verify-no-changes`). Style *preferences* are kept at suggestion level so
# they surface in editors/`dotnet format style` without failing the build or
# fighting the code's intentionally mixed `var` usage.

# using directives: System.* first, outside the namespace (matches the code)
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:suggestion
dotnet_style_namespace_match_folder = false

# Namespaces are block-scoped here, not file-scoped
csharp_style_namespace_declarations = block_scoped:suggestion

# `var` usage is intentionally mixed in this code — keep it a suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Allman braces (opening brace on its own line)
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# Indentation
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_labels = one_less_than_current

# Spacing
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_call_parameter_list_parentheses = false

# Prefer language keywords over BCL type names (int vs Int32)
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion

# Modern expression preferences (kept as suggestions, not build-breakers)
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
csharp_prefer_braces = false:suggestion

# --- code-quality analyzer (CAxxxx) tuning ---
# Public fields on the DTO/handle types (Node, OpenFile, Bridge.Waiter) are a
# deliberate lightweight-struct pattern, not a public API surface — don't flag.
dotnet_diagnostic.CA1051.severity = none

# --- Naming: private/internal fields use _camelCase ---
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_rule.private_fields_underscore.symbols = private_internal_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case

dotnet_naming_symbols.private_internal_fields.applicable_kinds = field
dotnet_naming_symbols.private_internal_fields.applicable_accessibilities = private, internal

dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _
